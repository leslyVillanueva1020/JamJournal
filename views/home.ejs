<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />

  <title>JamJournal - Home</title>
</head>
<body>
  <%- include('partials/nav') %>

  <main class="home-page">
    <% if (user) { %>
      <section class="dashboard-hero container py-5">
        <div class="dashboard-hero__content">
          <p class="eyebrow mb-2">Welcome back</p>
          <h1 class="display-title mb-3">Your music world, all in one place.</h1>
          <p class="hero-subtext mb-4">
            Track what you love, review songs, and keep up with the people whose taste you trust.
          </p>

          <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
            <button
              type="button"
              class="btn btn-brand"
              data-bs-toggle="modal"
              data-bs-target="#addSongModal">
              Add Review
            </button>

            <button
              type="button"
              class="btn btn-danger-soft"
              data-bs-toggle="modal"
              data-bs-target="#deleteSongModal">
              Delete Review
            </button>
          </div>
        </div>
      </section>

      <section class="container pb-5">
        <div class="section-heading d-flex justify-content-between align-items-center mb-4">
          <div>
            <p class="section-kicker mb-1">Community feed</p>
            <h2 class="section-title mb-0">Friends’ Reviews</h2>
          </div>
        </div>

        <% if (friendsFeed && friendsFeed.length > 0) { %>
          <div class="row g-4">
            <% friendsFeed.forEach(function(r) { %>
              <div class="col-12 col-md-6 col-xl-4">
                <article class="review-card h-100">
                  <div class="review-card__top">
                    <img
                      src="<%= r.albumArt || '/images/placeholder-album.png' %>"
                      alt="Album art for <%= r.songTitle %>"
                      class="review-card__art" />

                    <div class="review-card__meta">
                      <div class="review-card__row">
                        <a class="review-card__user" href="/u/<%= r.friendUsername %>">
                          @<%= r.friendUsername %>
                        </a>
                        <span class="rating-pill"><%= r.rating %>/10</span>
                      </div>

                      <h3 class="review-card__title"><%= r.songTitle %></h3>
                      <p class="review-card__artist mb-1"><%= r.artist %></p>

                      <small class="review-card__time">
                        <time datetime="<%= r.createdISO %>"><%= r.createdHuman %></time>
                      </small>
                    </div>
                  </div>

                  <% if (r.comment) { %>
                    <p class="review-card__comment mt-3 mb-0">
                      "<%= r.comment %>"
                    </p>
                  <% } else { %>
                    <p class="review-card__comment review-card__comment--muted mt-3 mb-0">
                      No written review, just a rating.
                    </p>
                  <% } %>
                </article>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <h3 class="empty-state__title">Your feed is quiet right now</h3>
            <p class="empty-state__text mb-0">
              Follow more users to start seeing reviews, ratings, and new music in your feed.
            </p>
          </div>
        <% } %>
      </section>

    <% } else { %>
      <section class="hero-section">
        <div class="container">
          <div class="row align-items-center g-5 min-vh-75">
            <div class="col-lg-6">
              <div class="hero-copy">
                <p class="eyebrow mb-3">Rate. Review. Discover.</p>
                <h1 class="hero-title mb-3">
                  The social journal for people who are serious about music.
                </h1>
                <p class="hero-subtext mb-4">
                  JamJournal lets you rate songs, write reviews, build your profile, and follow friends to discover what’s worth listening to next.
                </p>

                <div class="d-flex flex-wrap gap-3">
                  <a href="/auth/signup" class="btn btn-brand btn-lg-custom">Create Account</a>
                  <a href="/auth/login" class="btn btn-ghost btn-lg-custom">Log In</a>
                </div>
              </div>
            </div>

            <div class="col-lg-6">
              <div class="hero-visual">
                <div class="floating-card floating-card--main">
                  <img src="/images/placeholder-album.png" alt="Album art" class="floating-card__art">
                  <div>
                    <p class="floating-card__label mb-1">Trending review</p>
                    <h3 class="floating-card__title mb-1">Blinding Lights</h3>
                    <p class="floating-card__artist mb-2">The Weeknd</p>
                    <span class="rating-pill">9/10</span>
                  </div>
                </div>

                <div class="floating-card floating-card--small floating-card--top">
                  <p class="floating-card__label mb-1">Friend activity</p>
                  <p class="mb-0">@alex rated “Nights” 10/10</p>
                </div>

                <div class="floating-card floating-card--small floating-card--bottom">
                  <p class="floating-card__label mb-1">New discovery</p>
                  <p class="mb-0">Find songs through people you follow.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="features-section py-5">
        <div class="container">
          <div class="text-center mb-5">
            <p class="section-kicker mb-2">Why JamJournal</p>
            <h2 class="section-title">Built for music lovers</h2>
          </div>

          <div class="row g-4">
            <div class="col-md-4">
              <article class="feature-card h-100">
                <div class="feature-icon">♪</div>
                <h3 class="feature-title">Review songs</h3>
                <p class="feature-text mb-0">
                  Rate tracks, write your thoughts, and build a personal history of what you’ve heard.
                </p>
              </article>
            </div>

            <div class="col-md-4">
              <article class="feature-card h-100">
                <div class="feature-icon">★</div>
                <h3 class="feature-title">Discover new music</h3>
                <p class="feature-text mb-0">
                  Search tracks, explore music, and find your next favorite song through community activity.
                </p>
              </article>
            </div>

            <div class="col-md-4">
              <article class="feature-card h-100">
                <div class="feature-icon">◎</div>
                <h3 class="feature-title">Follow great taste</h3>
                <p class="feature-text mb-0">
                  Connect with friends, follow profiles, and see what other listeners are rating and reviewing.
                </p>
              </article>
            </div>
          </div>
        </div>
      </section>
    <% } %>
  </main>

  <% if (user) { %>
    <div class="modal fade" id="addSongModal" tabindex="-1" aria-labelledby="addSongModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content modal-dark">
          <div class="modal-header border-0">
            <h5 id="addSongModalLabel" class="modal-title">Add a New Song</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>

          <div class="modal-body">
            <form action="/reviews" method="post" class="row g-3">
              <div class="col-12 col-md-6">
                <label class="form-label">Title</label>
                <input name="title" class="form-control" required />
              </div>

              <div class="col-12 col-md-6">
                <label class="form-label">Artist</label>
                <input name="artist" class="form-control" required />
              </div>

              <div class="col-12 col-md-6">
                <label class="form-label">Genre</label>
                <input name="genre" class="form-control" />
              </div>

              <div class="col-12 col-md-6">
                <label class="form-label">Rating (1–10)</label>
                <input type="number" name="rating" min="1" max="10" class="form-control" required />
              </div>

              <div class="col-12">
                <label class="form-label">Comment</label>
                <textarea name="comment" rows="3" class="form-control"></textarea>
              </div>

              <div class="col-12 text-end">
                <button type="button" class="btn btn-ghost me-2" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-brand">Save Review</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <% if (user) { %>
    <div class="modal fade" id="deleteSongModal" tabindex="-1" aria-labelledby="deleteSongModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content modal-dark">
          <div class="modal-header border-0">
            <h5 id="deleteSongModalLabel" class="modal-title">Delete a Review</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>

          <div class="modal-body">
            <% if (typeof myReviews !== 'undefined' && myReviews.length > 0) { %>
              <form action="/reviews/delete" method="post">
                <div class="mb-3">
                  <label class="form-label">Select a review to remove</label>
                  <select name="reviewId" class="form-select" required>
                    <option value="" disabled selected>-- Choose a song --</option>
                    <% myReviews.forEach(function(review) { %>
                      <option value="<%= review.reviewId %>"><%= review.Title %> by <%= review.Artist %></option>
                    <% }); %>
                  </select>
                </div>

                <div class="delete-warning mb-3">
                  This action permanently removes your review.
                </div>

                <div class="text-end">
                  <button type="button" class="btn btn-ghost me-2" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" class="btn btn-danger-soft">Delete</button>
                </div>
              </form>
            <% } else { %>
              <p class="text-center text-secondary mb-0">You haven't added any songs yet.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/home.js" defer></script>
</body>
</html>