<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css" />
  <title>JamJournal - Lyrics</title>
</head>
<body>
  <%- include('partials/nav') %>

  <main class="lyrics-page">
    <section class="lyrics-hero">
      <div class="container">
        <div class="lyrics-panel">
          <p class="eyebrow mb-2">Find lyrics fast</p>
          <h1 class="lyrics-title mb-3">Search for Lyrics</h1>
          <p class="hero-subtext mb-4">
            Look up song lyrics by artist and title.
          </p>

          <form method="get" action="/lyrics" class="row g-3 mb-0">
            <div class="col-md-6">
              <label class="form-label lyrics-label">Artist</label>
              <input
                name="artist"
                class="form-control"
                required
                value="<%= artist %>"
                placeholder="Enter artist name">
            </div>

            <div class="col-md-6">
              <label class="form-label lyrics-label">Song Title</label>
              <input
                name="title"
                class="form-control"
                required
                value="<%= title %>"
                placeholder="Enter song title">
            </div>

            <div class="col-12">
              <button class="btn btn-brand">Search</button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <section class="container pb-5">
      <% if (error) { %>
        <div class="lyrics-alert">
          <%= error %>
        </div>
      <% } %>

      <% if (lyrics) { %>
        <div class="lyrics-result-card">
          <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
              <p class="section-kicker mb-1">Results</p>
              <h2 class="lyrics-result-title mb-0">
                <%= title %> <% if (artist) { %><span class="lyrics-result-meta">by <%= artist %></span><% } %>
              </h2>
            </div>
          </div>

          <pre class="lyrics-pre"><%= lyrics %></pre>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>