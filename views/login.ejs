<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css" />

  <title>JamJournal - Login</title>
</head>

<body>
  <%- include('partials/nav') %>

  <main class="auth-page">
    <div class="auth-container">

      <div class="auth-card">
        <div class="auth-header text-center mb-4">
          <p class="eyebrow mb-2">Welcome back</p>
          <h1 class="auth-title">Log in</h1>
        </div>

        <% if (typeof error !== 'undefined') { %>
          <div class="auth-error mb-3">
            <%= error %>
          </div>
        <% } %>

        <form method="post" action="/auth/login" class="auth-form" autocomplete="off">
          <div class="mb-3">
            <label class="form-label auth-label">Username</label>
            <input name="username" class="form-control" required placeholder="Enter username">
          </div>

          <div class="mb-4">
            <label class="form-label auth-label">Password</label>
            <input name="password" type="password" class="form-control" required placeholder="Enter password">
          </div>

          <button class="btn btn-brand w-100 mb-3">Log in</button>

          <p class="auth-footer text-center mb-0">
            Don’t have an account?
            <a href="/auth/signup">Sign up</a>
          </p>
        </form>
      </div>

    </div>
  </main>
</body>
</html>